# Firebase project configuration
# Copy this file to .env.local and fill in your Firebase project values
# Get these from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_MEASUREMENT_ID=your_app_measurement_id

# Comma-separated list of authorized Google email addresses
# Leave empty to allow any Google account
VITE_ALLOWED_EMAILS=your.email@gmail.com
